# ============================================================
# Biến môi trường cho profile CLOUD
# Copy file này thành .env và điền giá trị thật
# KHÔNG commit file .env lên Git
# ============================================================

SPRING_PROFILES_ACTIVE=cloud

# Database
DB_HOST=your-cloud-db-host.example.com
DB_PORT=3306
DB_NAME=meal_planner_db
DB_USERNAME=meal_planner_user
DB_PASSWORD=your_strong_password_here

# JWT
JWT_SECRET=your-super-secret-key-minimum-32-characters-long
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# Server
SERVER_PORT=8080

# Frontend URL (CORS)
FRONTEND_URL=https://mealplanner.vn
